    <!DOCTYPE html>
<html lang="ru">
<head>
  <link rel="icon" href="/media/icon.ico">
    <link rel="stylesheet" href="/static/globals.css">
    <link rel="stylesheet" href="/static/profile.css">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.username %></title>
</head>
<body>
  <div class="alertBar">
    <p></p>
  </div>
  <% if (user.mine == true) { %>
        <div class="container">
          <div class="profile">
            <div class="avatar">
              <img
                src="<%= user.avatar || 'http://localhost:9999/media/people.png' %>"
                alt="Аватар пользователя"
              />
              <span class="bio"><%= user.bio || "" %></span>
            </div>
            <h2 class="username"><%= user.username %>
            </h2>
            <div class="dataChange">
     <img src="/media/settings.svg" alt="settings">
   </div>
          </div>
        </div>
        <div class="settings">
          <img src="/media/close.svg" alt="close" class="closeSettings">
  
          <div class="options">
            <button class="option account">Account</button>
        </div>
          <div class="values">
            <div class="accountValues valuesContainer">
              <h3>Имя пользователя</h3>
              <input type="text" class="value" id="usernameValue" value=<%= user.username %> >
              <h3>Аватар</h3>
              <input type="file" class="value" id="avatarValue">
            </div>
            <button class="confirmButton">Подтвердить</button>
          </div>
        </div>
    <script src="/static/profileSettings.js"></script>
  <% } else { %>
        <div class="container">
  <div class="profile" id='<%= user.id %>'>
            <div class="avatar">
              <img
                src="<%= user.avatar || 'http://localhost:9999/media/people.png' %>"
                alt="Аватар пользователя"
              />
              <span class="bio"><%= user.bio || "" %></span>
            </div>
            <h2 class="username"><%= user.username %>
            </h2>
  
            <div class="addFriend">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 13.5997 2.37562 15.1116 3.04346 16.4525C3.22094 16.8088 3.28001 17.2161 3.17712 17.6006L2.58151 19.8267C2.32295 20.793 3.20701 21.677 4.17335 21.4185L6.39939 20.8229C6.78393 20.72 7.19121 20.7791 7.54753 20.9565C8.88837 21.6244 10.4003 22 12 22Z" stroke="#000000" stroke-width="1.5"></path> </g></svg>
            </div>
            </div>
        </div>
        <script src="/static/socket.io.min.js"></script>
        <script src="/static/profileNotMine.js" type="module"></script>
    <%} %>
</body>
</html>
